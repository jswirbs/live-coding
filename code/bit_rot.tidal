      d11 $ (2 <~) $ fast 4 $ n (slow 1 $ ("a4 e a c6 b e6 a6 f6" - "1")) # s "warsawbass" # octave 8 # djf (slow 8 $ range 0.5 0.3 sine) # waveloss 30 # rvb 0.8 0.5 # distort (slow 4 $ range 0.2 0.5 sine) # pan (slow 4 $ range 0.25 0.75 saw) # sustain (slow 3 $ range 0.08 0.15 sine) # gain 0.92

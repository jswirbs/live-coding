      d10 $ swingBy (1/16) 0.5 $ (2 <~) $ sometimes (ghost) $ rev $ fast 4 $ n ((choose([8.03125,8,8]) ~>) $ slow 2 $ ("a4 e a c6 b e6 a6 f6" - "1")) # s "superzow" # octave (choose[5,5,6]) # detune (fast 2 $ range 0 3 perlin) # waveloss 8 # rvb 0.4 0.3 # distort (slow 4 $ range 0.1 0.3 sine) # pan (range 0.25 0.75 rand) # sustain (slow 3 $ range 0.07 0.16 sine) # gain 0.55 # hcutoff 300

      d10 $ swingBy (1/16) 0.5 $ (2 <~) $ sometimes (ghost) $ rev $ fast 4 $ n ((choose([8.03125,8,8]) ~>) $ slow 2 $ ("a4 e a c6 b e6 a6 f6" - "1")) # s "superzow" # octave (choose[5,5,6]) # detune (fast 2 $ range 0 3 perlin) # waveloss 0 # rvb 0.9 0.95 # distort (slow 4 $ range 0.1 0.3 sine) # pan (range 0.25 0.75 rand) # sustain (slow 3 $ range 0.3 0.16 sine) # gain 0.47 # hcutoff 400
      d10 $ swingBy (1/16) 0.5 $ (2 <~) $ sometimes (ghost) $ rev $ fast 2 $ n ((choose([8.03125,8,8]) ~>) $ slow 2 $ ("a4 e a c6 b e6 a6 f6" - "1")) # s "superzow" # octave (choose[5,5,6]) # detune (fast 2 $ range 0 3 perlin) # waveloss 40 # rvb 0.9 0.99 # distort (slow 4 $ range 0.1 0.3 sine) # pan (range 0.25 0.75 rand) # sustain (slow 3 $ range 0.6 0.3 sine) # gain 0.45 # hcutoff 400

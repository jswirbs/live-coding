      d8 $ whenmod 4 2 (swingBy (1/16) 0.5) $ arp "up" $ n "<gs'min gs'min gs'min b4'min>@3 ~@5" # s "basslow" # octave "[5,4]" # cutoff (slow 10 $ range 4000 6000 sine) # gain 0.8 # hcutoff 600 # resonance (slow 20 $ range 0.1 0.2 sine) # sustain 0.09

      d8 $ whenmod 4 2 (swingBy (1/16) 0.5) $ arp "up" $ n "<gs'min gs'min gs'min b4'min>@3 ~@5" # s "basslow" # octave "[5,4]" # cutoff (slow 10 $ range 4000 6000 sine) # gain 0.72 # hcutoff 600 # resonance (slow 20 $ range 0.1 0.2 sine) # sustain (slow 4 $ range 0.15 0.2 saw) # room (slow 8 $ range 0.15 0.3 sine) # size 0.97


      -- d7 $ n "[gs(5,8)]*2" # s "acid91" # gain 0.85 # octave 4 # squiz (range 2 3.3 perlin) # waveloss 6 # cutoff (slow 16 $ range 1600 1800 sine) # resonance (slow 20 $ range 0 0.12 sine)



      d8 $ whenmod 4 2 (swingBy (1/16) 0.5) $ arp "up" $ n "<gs'min gs'min gs'min b4'min>@3 ~@5" # s "acid91" # octave "[3,4,5]" # cutoff (slow 10 $ range 3000 6000 sine) # room (slow 8 $ range 0.15 0.3 sine) # size 0.92 # gain 0.8 # hcutoff 1000 # resonance (slow 20 $ range 0 0.12 sine)
      d8 $ whenmod 4 2 (swingBy (1/16) 0.5) $ arp "up" $ n "<gs'min gs'min gs'min b4'min>@2 ~@4" # s "acid91" # octave "[3,4,5]" # cutoff (slow 10 $ range 3000 6000 sine) # room (slow 8 $ range 0.15 0.3 sine) # size 0.92 # gain 0.8 # hcutoff 1000 # resonance (slow 20 $ range 0 0.12 sine)

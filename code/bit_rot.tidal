-- microtonic: SC SD Elec Short





    -- core loop
    do
      bpm 112
      resetCycles
      d1 $ n "[0 ~ ~ 0] [0 ~ ~ 0] [~ 0 ~ ~] [~ 0 ~ ~]" # s "m1" # midichan 0 # stack[(ccv 96 # ccn 5), (ccv 0 # ccn 9)]
      d1 $ n "[0 ~ ~ 0] [0 ~ ~ 0] [~ 0 ~ ~] [~ 0 ~ ~]" # s "m1" # midichan 0 # stack[(ccv 96 # ccn 5), (ccv 120 # ccn 9)]
      d2 $ n "[~ 0]*4" # s "m1" # midichan 6 # ccv 75 # ccn 5
      d3 $ n "[~ 0]*2" # s "m1" # midichan 4 # stack[(ccv 92 # ccn 5), (ccv (slow 8 $ range 90 110 sine) # ccn 16)]
      d5 $ swingBy (1/16) 1 $ n "[0 ~ 0 ~]*3@3 [<0 ~> 0 ~ 0]" # s "m1" # midichan 3 # ccv 90 # ccn 5
      d6 $ slice 32 "<[~ [1 ~ ~ 2] ~ ~]*3@3 [~ 1 ~ ~]>" $ s "nebula" # hcutoff 50 # cutoff 2000 # gain 1.05 # n 4 # room 0.2
      d10 $ swingBy (1/16) 0.5 $ (2 <~) $ sometimes (ghost) $ rev $ fast 4 $ n ((choose([8.03125,8,8]) ~>) $ slow 2 $ ("a4 e a c6 b e6 a6 f6" - "1")) # s "superzow" # octave (choose[5,5,6]) # detune (fast 2 $ range 0 3 perlin) # waveloss 8 # rvb 0.4 0.3 # distort (slow 4 $ range 0.1 0.3 sine) # pan (range 0.25 0.75 rand) # sustain (slow 3 $ range 0.07 0.16 sine) # gain 0.55 # hcutoff 300



      d9 $ swingBy (1/16) 1 $ chop 32 $ slow 4 $ s "techno_textures" # n 34 # gain 0.95 # distort 0.2 # room 0 # size 0 # cutoff (slow 2 $ "3000 2000 1100 700")



        d8 $ slow 2 $ n "gs*32" # octave "<3>" # s "basslow" # voice 5 # gain 0.8 # pan (range 0.25 0.75 sine) # cutoff (slow 2 $ range 500 1000 sine) # hcutoff 120
        d8 $ slow 2 $ n "gs*32" # octave "<5>" # s "basshigh" # voice 5 # gain ("[0.6 0.7 0.8 0.78]*8") # pan (range 0.75 0.25 sine) # cutoff (slow 6 $ range 800 2000 sine) # hcutoff 700
        d8 $ slow 2 $ n "gs*32" # octave "<5>" # s "basshigh" # voice 5 # gain ("[0.6 0.7 0.8 0.78]*8" - "0.15") # pan (range 0.75 0.25 sine) # cutoff (slow 6 $ range 800 2000 sine) # hcutoff 700 # resonance (range 0.3 0.4 rand) # sustain (slow 2 $ range 0.05 0.07 saw)
        d8 $ slow 2 $ arp "up" $ n "gs'min*8" # octave "<5>" # s "basshigh" # voice 5 # gain ("[0.6 0.7 0.8 0.78]*8" - "0.15") # pan (range 0.75 0.25 sine) # cutoff (slow 6 $ range 800 2000 sine) # hcutoff 700 # resonance (range 0.3 0.4 rand) # sustain (slow 2 $ range 0.05 0.07 saw)
          d7 silence

      d8 $ n "[~ gs] ~ ~ ~" # s "acid91" # gain 0.77 # octave 4 # squiz (range 2 3.3 perlin) # waveloss 6 # cutoff (slow 16 $ range 1600 1800 sine) # resonance (slow 20 $ range 0.1 0.22 sine) # sustain 0.2
      d8 $ n "~ ~ ~ [~ gs]" # s "acid91" # gain 0.8 # octave 4 # squiz (range 2 3.3 perlin) # waveloss 6 # cutoff (slow 16 $ range 1600 1800 sine) # resonance (slow 20 $ range 0.1 0.22 sine) # sustain 0.2


bpm 142

-- E
d1 $ s "SOPHIE_subs*4" # n 10
d1 $ slice "2 3 2 <4 6>" "0*4" $ s "SOPHIE_subs" # n 10
d1 $ slice "2 3 2 <4 6>" "0*4" $ s "SOPHIE_subs" # n 10 # distort (segment 4 $ fast 4 $ range 0 0.1 perlin) # gain 1.05





d2 $ slow 8 $ chop 32 $ s "trancey_synth_loops" # n 19

d2 $ n "~ [0 0 ~ 0] 0 ~" # s "sostoms" # triode 2 # cutoff (slow 12 $ range 2000 6000 sine) # resonance (slow 8 $ range "[0.2 0.3 0.4 0.5]*2" 0 square)
d2 $ n "~ [0 ~ ~ 0] 0 0" # s "sostoms"

d2 $ n "~ [0 ~ ~ 0 ~] 0*2 0" # s "sostoms"
d2 $ n "~ [0 ~ ~ 1 ~ ~] [~ 0] [0 ~]" # s "sostoms"
d2 $ n ("~ [0 ~ ~ 0 ~ ~] [~ 0] [0 ~]") # octave 6 # s "soshats"

d3 silence


  d3 $ n "e4*4" # s "acid91" # sustain (range 0.08 0.14 rand) # triode 2 # cutoff (range 2000 3000 perlin) # resonance (slow 8 $ range (range 0.1 0.3 saw) 0 square)
  d3 $ n "e4*4" # s "acid91" # gain 0.94 # sustain (range (slow 16 $ range 0.08 0.12 sine) (slow 16 $ range 0.14 0.18 sine) rand) # triode 2 # cutoff (range 2000 3000 perlin) # resonance (slow 8 $ range (range 0.1 0.3 saw) 0 square)
  d3 $ n "e4*4" # s "acid91" # gain 0.94 # sustain (range (slow 16 $ range 0.08 0.12 sine) (slow 16 $ range 0.14 0.18 sine) rand) # triode 2 # cutoff (range 2000 3000 perlin) # resonance (slow 8 $ range (range 0.1 0.3 saw) 0 square)




  clutchIn 3 16 silence
  d6 $ s "XORE_hats*<16*7@7 [8 4]>" # n 9 # note "-12" # cutoff (fast 3 $ range 3000 8000 sine) # distort 0.2 # rvb 0.2 0.3 # resonance (slow 8 $ range 0.3 0.7 saw) # gain 0.85



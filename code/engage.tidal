bpm 142


d1 $ n "0*4" # s "m1" # midichan 0


d2 $ n "~ [0 0 ~ 0] 0 ~" # s "sostoms" # triode 2 # cutoff (slow 12 $ range 2000 6000 sine) # resonance (slow 8 $ range "[0.2 0.3 0.4 0.5]*2" 0 square)


d3 $ n "e [~ ~ ~ ~ e ~ ~ ~] ~ ~" # s "m2" # octave 5 # sustain 0.4

d4 $ (0.125 ~>) $ n "0*4" # s "m1" # midichan 4
d7 silence


d10 $ slice 408 "<16 16 16 <27 27 23 25> 19*4@4>*4" $ s "flow2000" # n 0 # cutoff 1000 # hcutoff 800 # room 0.7 # size 0.98 # gain 0.7
d10 $ slice 408 "<16 16 16 <27 27 23 25> 19*4@4>*2" $ s "flow2000" # n 0 # cutoff 1000 # hcutoff 800 # room 0.7 # size 0.98 # gain 0.7
d10 $ slice 408 "23*4" $ s "flow2000" # n 0 # cutoff 1000 # hcutoff 800 # room 0.7 # size 0.98 # gain 0.7

d10 $ palindrome $ slow 2 $ chop 16 $ slice 204 "18 22" $ s "flow2000" # n 0 # hcutoff (slow 4 $ range 300 600 sine) # triode (fast 4 $ choose[0,0,0,2,4]) # room 0.1 # size 0







